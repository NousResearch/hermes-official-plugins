{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "meshy": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@meshy-ai/meshy-mcp-server@0.6.5"
      ],
      "cwd": "${PLUGIN_DATA}",
      "env": {
        "MESHY_API_KEY": "${MESHY_API_KEY}"
      }
    }
  }
}
