{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "rea": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@6.4.0",
        "mcp"
      ],
      "env": {
        "GHIDRA_INSTALL_DIR": "${GHIDRA_INSTALL_DIR}",
        "REA_GHIDRA_STARTUP_TIMEOUT_MS": "900000",
        "REA_PWNTOOLS_PYTHON": "${REA_PWNTOOLS_PYTHON}"
      }
    }
  }
}
